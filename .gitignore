# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
# Native (Capacitor) web assets, built by npm run build:mobile
dist-mobile
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Capacitor native project folders (generated — run 'npx cap add ios/android' to recreate)
ios/
android/
.vercel

# Local env files -- MASSIVE_API_KEY (live-pricing quote proxy) and any
# other secrets get set here for `vercel dev`/local testing and in Vercel's
# project settings for the real deployment, never as literal values in
# tracked source. .env.example (tracked) documents the expected keys with
# placeholder values only.
.env
.env.local
.env.*.local

# Belt-and-suspenders: scripts/mint-premium-jwt.mjs defaults to storing the
# JWT signing keypair outside this repo entirely (in the user's home
# directory), specifically so there's no gitignore rule standing between it
# and an accidental `git add -A` -- but if CFE_PREMIUM_KEY_PATH ever points
# somewhere inside this tree instead, this still catches it.
.cashflowengine-premium-key.json

# Personal plan exports/backups -- these contain real names, income,
# account balances, and other financial details and must never be
# committed. Matches any file starting with "britton" (this household's
# exported config/notes) plus every filename pattern the app's own
# export/download buttons produce, in case one ever lands in the repo
# folder: LedgerTab.jsx's "Export JSON" (retire_plan_backup_*) and "Export
# Yearly Ledger (CSV)" (retirement_projection_*), and App.jsx's separate
# "download config" action (retire_plan_config_*).
britton*
retire_plan_backup_*.json
retire_plan_config_*.json
retirement_projection_*.csv

# Test tool output -- regenerated by `npx playwright test` / `npx vitest`,
# not source. Not a personal-data risk today (tests run against demo data),
# but standard practice to keep out of the repo regardless.
lint_output.txt
sankey_initial.png
playwright-report/
test-results/
coverage/

# Brokerage statements and full backups -- real names, account numbers and
# balances. The statement import is developed against made-up text fixtures
# (src/__tests__/fixtures/statements/), never a real statement, so no PDF
# belongs in this repository except the reviewed documents under docs/.
*.pdf
!docs/**/*.pdf
outlastretirement_full_backup_*.json
