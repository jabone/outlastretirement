{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/__tests__/**"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ],
  "ignorePatterns": [
    "src/__tests__/fixtures/**",
    "_to_delete/**"
  ]
}
